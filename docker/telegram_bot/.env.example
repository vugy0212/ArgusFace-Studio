# ============================================================
# ArgusFace 24/7 Telegram Bot - Konfiguracija okruženja
# ============================================================

# Token koji ste dobili od @BotFather-a na Telegramu:
TELEGRAM_BOT_TOKEN=unesite_vas_token_ovdje

# Dozvoljeni Telegram Chat ID-jevi (odvojeni zarezom).
# Ostavite prazno ako želite dopustiti pristup svima, ili unesite svoj Chat ID:
# (Svoj Chat ID možete saznati slanjem /start naredbe botu)
ALLOWED_CHAT_IDS=

# URL do ArgusFace Studio API poslužitelja na vašem računalu.
# U Docker okruženju adresa računala je host.docker.internal
ARGUSFACE_API_URL=http://host.docker.internal:5055

# Opcionalni API ključ (ostavite prazno ako ga niste postavili u ArgusFace Studio postavkama):
ARGUSFACE_API_KEY=
